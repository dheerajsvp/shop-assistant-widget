# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit a real key.
#
# The AI assistant is optional. Without a key the widget works exactly as before, using its
# built-in keyword assistant.

# Free key from https://aistudio.google.com ("Get API key")
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.1-flash-lite
# Time budget for one AI reply, in milliseconds. Keep it under your host's function timeout
# (Netlify's default is about 10 seconds).
# AI_DEADLINE_MS=8500
